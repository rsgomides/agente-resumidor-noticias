# ====================================================================
# Configurações do Agente Resumidor & Curador de Notícias
# ====================================================================

# 1. Chave de API do Google Gemini (Obtenha gratuitamente em: https://aistudio.google.com/app/apikey)
# Se deixar em branco, o agente executará em Modo Demonstração (curadoria local estruturada).
GEMINI_API_KEY=

# 2. Modelo do Gemini a utilizar (Exemplos: gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# 3. Quantidade de notícias principais a selecionar e aprofundar
TOP_NEWS_COUNT=3

# 4. Idioma de saída da curadoria
LANGUAGE=pt-br
